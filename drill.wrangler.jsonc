// Config for the SEPARATE CL Academy worker.
// The main wrangler.jsonc still serves Chase from ./site — this one
// serves only the training site, with its own address.
// In Cloudflare, connect this repo a second time with the deploy command:
//   npx wrangler deploy --config drill.wrangler.jsonc
{
  "name": "cl-academy",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./site/drill",
    "not_found_handling": "single-page-application"
  }
}
